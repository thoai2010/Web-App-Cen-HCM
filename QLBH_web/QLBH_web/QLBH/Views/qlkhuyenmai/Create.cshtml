@model QLBH.Models.KhuyenMai
@{
    ViewBag.Title = "Thêm khuyến mãi";

    // Lấy vai trò từ Session
    var role = Session["VaiTro"] != null ? Session["VaiTro"].ToString() : "";

    // Nếu là admin thì dùng AdminLayout
    if (role == "Admin" || role == "1")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_NhanVien.cshtml";

    }

    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
    string cenBgLight = "#F5F6F8";
}

<style>
    body { background-color:@cenBgLight; }
    .cen-header { color:@cenGreen; font-weight:700; }
    .card { border:none; border-radius:15px; box-shadow:0 4px 10px rgba(0,0,0,0.1); }
    .btn-cen { background-color:@cenOrange; color:white; border:none; transition:.3s; }
    .btn-cen:hover { background-color:#ff9b2f; }
    .form-label { font-weight:600; color:@cenGreen; }
</style>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="cen-header"><i class="bi bi-gift-fill"></i> Thêm chương trình khuyến mãi</h2>
        <a href="@Url.Action("Index", "QLKhuyenMai")" class="text-decoration-none text-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card p-4">
        @using (Html.BeginForm("Create", "QLKhuyenMai", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Mã khuyến mãi</label>
                    @Html.TextBoxFor(m => m.MaKM,
                        new
                             {
                            @class = "form-control",
                            @readonly = "readonly",
                            @Value = Model.MaKM ?? ViewBag.NewMaKM
                        })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Tên chương trình</label>
                    @Html.TextBoxFor(m => m.TenCT, new { @class = "form-control", placeholder = "Nhập tên chương trình", required = "required" })
                    @Html.ValidationMessageFor(m => m.TenCT, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Ngày bắt đầu</label>
                    @Html.TextBoxFor(m => m.NgayBD, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                    @Html.ValidationMessageFor(m => m.NgayBD, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Ngày kết thúc</label>
                    @Html.TextBoxFor(m => m.NgayKT, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                    @Html.ValidationMessageFor(m => m.NgayKT, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-12">
                    <label class="form-label">Loại khuyến mãi</label>
                    @Html.DropDownListFor(m => m.LoaiKM,
                        new SelectList(new[]
                        {
                            new { Value="Tien", Text="Tiền"},
                            new { Value="PhanTram", Text="Phần trăm"},
                        }, "Value", "Text"),
                        "Chọn loại khuyến mãi",
                        new { @class = "form-control", required = "required" }
                    )
                    @Html.ValidationMessageFor(m => m.LoaiKM, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-12">
                    <label class="form-label">Mô tả</label>
                    @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 3, placeholder = "Nhập mô tả" })
                </div>

            </div>

            <div class="mt-4 text-end">
                <button type="submit" class="btn btn-cen px-4">
                    <i class="bi bi-save"></i> Lưu
                </button>
                <a href="@Url.Action("Index", "QLKhuyenMai")" class="btn btn-secondary px-4">
                    <i class="bi bi-x-circle"></i> Hủy
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
