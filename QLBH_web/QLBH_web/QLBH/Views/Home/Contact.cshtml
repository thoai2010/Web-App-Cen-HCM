@{
    ViewBag.Title = "Liên hệ - CEN HCM";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
}

<style>
    body { background-color: #F5F6F8; }

    .contact-page {
        background-color:@cenGreen;
        color:white;
        border-radius:8px;
    }

    .btn-send {
        background-color:@cenOrange;
        color:white;
        border-radius:6px;
        padding:8px 30px;
        font-weight:600;
        transition:.3s;
    }
    .btn-send:hover {
        background-color:#e68310;
        color:white;
    }

    .form-control {
        border-radius:6px;
        border:2px solid #eee;
    }
    .form-control:focus {
        border-color:@cenOrange;
        box-shadow:none;
    }
</style>

<section class="contact-page py-5">
    <div class="container">
        <div class="row align-items-start">
            <!-- Company Info -->
            <div class="col-md-5 mb-4">
                <img src="~/Content/images/logo-cenhcm-white.jpg" alt="CEN HCM" style="width:200px;" />
                <ul class="list-unstyled mt-3">
                    <li><strong>Hotline:</strong> @ViewBag.Company.Hotline</li>
                    <li><strong>Email:</strong> @ViewBag.Company.Email</li>
                    <li><strong>Địa chỉ:</strong> @ViewBag.Company.DiaChi</li>
                </ul>
            </div>

            <!-- Contact Form -->
            <div class="col-md-7">
                <h4 class="text-center fw-bold mb-4">LIÊN HỆ VỚI CHÚNG TÔI</h4>
                <form method="post" action="@Url.Action("GuiLienHe","Home")">
                    <div class="form-group mb-3"><input class="form-control" name="Ten" placeholder="Tên của bạn" /></div>
                    <div class="form-group mb-3"><input class="form-control" name="Email" placeholder="Email của bạn" /></div>
                    <div class="form-group mb-3"><input class="form-control" name="SDT" placeholder="Số điện thoại" /></div>
                    <div class="form-group mb-3"><textarea class="form-control" name="NoiDung" rows="4" placeholder="Nội dung liên hệ"></textarea></div>
                    <div class="text-center"><button type="submit" class="btn btn-send">GỬI LIÊN HỆ</button></div>
                </form>
            </div>
        </div>

        <!-- Map -->
        <div class="mt-5">
            <iframe src="https://www.google.com/maps?q=57%20Nguy%E1%BB%85n%20C%C6%A1%20Th%E1%BA%A1ch,%20An%20Kh%C3%A1nh,%20TP.%20Th%E1%BB%A7%20%C4%90%E1%BB%A9c,%20TP.HCM&output=embed"
                    width="100%" height="400" style="border:0; border-radius:8px;" allowfullscreen></iframe>
        </div>

        <div class="text-center mt-4">
            <small>© 2025 <strong>CEN HCM</strong> - Realizing your dreams</small>
        </div>
    </div>
</section>
