@model QLBH.Models.LoaiSanPham
@{
    ViewBag.Title = "Sửa loại sản phẩm";

    // Lấy vai trò từ Session
    var role = Session["VaiTro"] != null ? Session["VaiTro"].ToString() : "";

    // Nếu là admin thì dùng AdminLayout
    if (role == "Admin" || role == "1")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_NhanVien.cshtml";

    }

    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
    string cenBgLight = "#F5F6F8";
}

<style>
    body { background-color: @cenBgLight; }
    .cen-header { color: @cenGreen; font-weight: 700; }
    .card { border: none; border-radius: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
    .btn-cen { background-color: @cenOrange; color: white; border: none; transition: .3s; }
    .btn-cen:hover { background-color: #ff9b2f; }
    .form-label { font-weight: 600; color: @cenGreen; }
    .btn-back { color: @cenGreen; font-weight: 500; text-decoration: none; }
    .btn-back:hover { color: @cenOrange; text-decoration: underline; }
</style>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="cen-header"><i class="bi bi-pencil-square"></i> Sửa loại sản phẩm</h2>
        <a href="@Url.Action("Index", "QLDanhMuc")" class="btn-back">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card p-4">
        @using (Html.BeginForm("Edit", "QLDanhMuc", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.MaLoai)

            <div class="row g-3">

                <div class="col-md-12">
                    <label class="form-label">Mã loại sản phẩm</label>
                    <input type="text" class="form-control" value="@Model.MaLoai" readonly />
                </div>

                <div class="col-md-12">
                    <label class="form-label">Tên loại sản phẩm</label>
                    @Html.TextBoxFor(m => m.TenLoai, new { @class = "form-control", placeholder = "Nhập tên loại sản phẩm", required = "required" })
                    @Html.ValidationMessageFor(m => m.TenLoai, "", new { @class = "text-danger" })
                </div>

            </div>

            <div class="mt-4 text-end">
                <button type="submit" class="btn btn-cen px-4">
                    <i class="bi bi-save"></i> Lưu thay đổi
                </button>
                <a href="@Url.Action("Index", "QLDanhMuc")" class="btn btn-secondary px-4">
                    <i class="bi bi-x-circle"></i> Hủy
                </a>
            </div>
        }
    </div>

</div>
