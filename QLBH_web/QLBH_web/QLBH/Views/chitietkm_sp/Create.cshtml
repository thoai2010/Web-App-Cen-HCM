@model QLBH.Models.ChiTietKM_SP

@{
    ViewBag.Title = "Thêm khuyến mãi cho sản phẩm";
    var role = Session["VaiTro"] != null ? Session["VaiTro"].ToString() : "";

    // Nếu là admin thì dùng AdminLayout
    if (role == "Admin" || role == "1")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_NhanVien.cshtml";

    }

    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
    string cenBgLight = "#F5F6F8";
}

<style>
    body { background-color: @cenBgLight; }
    .cen-header { color:@cenGreen; font-weight:700; }
    .card { border:none; border-radius:15px; box-shadow:0 4px 10px rgba(0,0,0,0.1); }
    .btn-cen { background-color:@cenOrange; color:white; border:none; transition:.3s; }
    .btn-cen:hover { background-color:#ff9b2f; }
    .form-label { font-weight:600; color:@cenGreen; }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="cen-header"><i class="bi bi-tags-fill"></i> Thêm khuyến mãi cho sản phẩm</h2>
        <a href="@Url.Action("Index", "ChiTietKM_SP")" class="text-decoration-none text-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="card p-4">
        @using (Html.BeginForm("Create", "ChiTietKM_SP", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Chọn chương trình khuyến mãi</label>
                    @Html.DropDownListFor(m => m.MaKM,
                        new SelectList(ViewBag.KhuyenMais, "MaKM", "TenCT"),
                        "-- Chọn chương trình --",
                        new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.MaKM, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Chọn sản phẩm</label>
                    @Html.DropDownListFor(m => m.MaSP,
                        new SelectList(ViewBag.SanPhams, "MaSP", "TenSP"),
                        "-- Chọn sản phẩm --",
                        new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.MaSP, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Trị giá khuyến mãi</label>
                    @Html.TextBoxFor(m => m.TriGia,
                        new { @class = "form-control", type = "number", step = "0.01", min = "0", placeholder = "Nhập trị giá", required = "required" })
                    @Html.ValidationMessageFor(m => m.TriGia, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Số lượng tối thiểu</label>
                    @Html.TextBoxFor(m => m.SoLuongToiThieu,
                        new { @class = "form-control", type = "number", min = "0", placeholder = "Nhập SL tối thiểu", required = "required" })
                    @Html.ValidationMessageFor(m => m.SoLuongToiThieu, "", new { @class = "text-danger" })
                </div>

            </div>

            <div class="mt-4 text-end">
                <button type="submit" class="btn btn-cen px-4">
                    <i class="bi bi-save"></i> Lưu
                </button>
                <a href="@Url.Action("Index", "ChiTietKM_SP")" class="btn btn-secondary px-4">
                    <i class="bi bi-x-circle"></i> Hủy
                </a>
            </div>
        }
    </div>
</div>
