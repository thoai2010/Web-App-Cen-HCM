@model QLBH.Models.RegisterViewModel
@{
    ViewBag.Title = "Đăng ký khách hàng";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-pb/VdxP0<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
      integrity="sha512-pb/VdxP0iVfNw4W7D2mZcJf6XwEEXgNf1U3i0mXyC+0jXxZP2rkP2iIx2swb7QGzyjLkMabY9eE+QAfWZs6+jQ=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />

<link rel="stylesheet" href="~/Content/style.css" />

<div class="login-container">
    <div class="logo">
        <img src="~/Content/Images/logo-cenhcm-white.jpg" alt="Logo" />
    </div>

    <h2>Đăng ký</h2>

    <!-- ⚡ Lỗi tổng -->

    <div style="color:red">@Html.ValidationSummary(true, "", new { @class = "text-danger summary-error" })</div>
    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="input-group">
            <label for="TenDangNhap">Tên đăng nhập</label>
            @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control", placeholder = "Tên đăng nhập" })

            <div style="color:red">@Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger" })</div>
        </div>

        <div class="input-group password-wrapper">
            <label for="MatKhau">Mật khẩu</label>
            <div class="password-container" style="position: relative;">
                @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", placeholder = "Mật khẩu", id = "passwordInput" })
                <span id="togglePassword1"
                      style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer;">
                    <i id="eyeIcon1" class="fa-solid fa-eye-slash"></i>
                </span>
            </div>

            <div style="color:red">@Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })</div>
        </div>

        <div class="input-group password-wrapper">
            <label for="XacNhanMatKhau">Xác nhận mật khẩu</label>
            <div class="password-container" style="position: relative;">
                @Html.PasswordFor(m => m.XacNhanMatKhau, new { @class = "form-control", placeholder = "Xác nhận mật khẩu", id = "confirmPasswordInput" })
                <span id="togglePassword2"
                      style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer;">
                    <i id="eyeIcon2" class="fa-solid fa-eye-slash"></i>
                </span>
            </div>

            <div style="color:red">@Html.ValidationMessageFor(m => m.XacNhanMatKhau, "", new { @class = "text-danger" })</div>
        </div>

        <button type="submit">Đăng ký</button>
    }

    <p class="note">@Html.ActionLink("Đã có tài khoản? Đăng nhập", "Login")</p>
</div>
<!-- 🔥 Script hiện / ẩn mật khẩu -->
<script>
    function setupTogglePassword(toggleId, inputId, iconId) {
        const toggle = document.getElementById(toggleId);
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);

        toggle.addEventListener("click", () => {
            const isHidden = input.type === "password";
            input.type = isHidden ? "text" : "password";
            icon.classList.toggle("fa-eye");
            icon.classList.toggle("fa-eye-slash");
        });
    }

    setupTogglePassword("togglePassword1", "passwordInput", "eyeIcon1");
    setupTogglePassword("togglePassword2", "confirmPasswordInput", "eyeIcon2");
</script>
