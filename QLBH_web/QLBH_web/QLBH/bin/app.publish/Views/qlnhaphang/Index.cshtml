@model IEnumerable<QLBH.Models.NhapHangViewModel>

@{
    ViewBag.Title = "Quản lý Phiếu nhập hàng";

    // Lấy vai trò từ Session
    var role = Session["VaiTro"] != null ? Session["VaiTro"].ToString() : "";

    // Nếu là admin thì dùng AdminLayout
    if (role == "Admin" || role == "1")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_NhanVien.cshtml";  
                        
    }

    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
    string cenBgLight = "#F5F6F8";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold"><i class="bi bi-box-seam"></i> Quản lý nhập hàng</h2>
        <div class="d-flex gap-2">
            @using (Html.BeginForm("Index", "QLNhapHang", FormMethod.Get))
            {
                <input type="text" name="search" value="@Request["search"]"
                       class="form-control search-box"
                       placeholder="🔍 Tìm phiếu nhập..." />
            }

            <a href="@Url.Action("Create", "QLNhapHang")" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Tạo phiếu nhập hàng
            </a>
        </div>
    </div>

    <table class="table table-bordered table-hover text-center align-middle">
        <thead class="table-success">
            <tr>
                <th>Mã phiếu nhập</th>
                <th>Ngày nhập</th>
                <th>Nhân viên</th>
                <th>Nhà cung cấp</th>
                <th>Tên sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
                <th>Tổng tiền phiếu</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaPNH</td>
                    <td>@item.NgayNhap.ToString("dd/MM/yyyy")</td>
                    <td>@item.TenNV</td>
                    <td>@item.TenNCC</td>
                    <td>@item.TenSP</td>
                    <td>@item.SoLuong</td>
                    <td>@string.Format("{0:N0} ₫", item.DonGia)</td>
                    <td>@string.Format("{0:N0} ₫", item.ThanhTien)</td>
                    <td>@string.Format("{0:N0} ₫", item.TongTien)</td>

                </tr>
            }
        </tbody>
    </table>
</div>
