phan tao loai: @model QLBH.Models.LoaiSanPham
@{
    ViewBag.Title = "Thêm Loại Sản Phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
    string cenBgLight = "#F5F6F8";
}

<style>
    body { background-color: @cenBgLight; }
    .cen-header { color: @cenGreen; font-weight: 700; }
    .card { border: none; border-radius: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
    .btn-cen { background-color: @cenOrange; color: white; border: none; transition: .3s; }
    .btn-cen:hover { background-color: #ff9b2f; }
    .form-label { font-weight: 600; color: @cenGreen; }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="cen-header"><i class="bi bi-plus-square"></i> Thêm Loại Sản Phẩm</h2>
        <a href="@Url.Action("Index", "QLDanhMuc")" class="text-decoration-none text-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }


    <div class="card p-4">
        @using (Html.BeginForm("Create", "QLDanhMuc", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Mã Loại</label>
                <input type="text" class="form-control" value="@Model.MaLoai" readonly style="background:#e9ecef;" />
                <input type="hidden" name="MaLoai" value="@Model.MaLoai" />
            </div>

            <div class="mb-3">
                <label class="form-label">Tên Loại</label>
                @Html.TextBoxFor(m => m.TenLoai, new { @class = "form-control", placeholder = "Nhập tên loại" })
                @Html.ValidationMessageFor(m => m.TenLoai, "", new { @class = "text-danger" })
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-cen px-4">
                    <i class="bi bi-save"></i> Lưu
                </button>
                <a href="@Url.Action("Index", "QLDanhMuc")" class="btn btn-secondary px-4">
                    <i class="bi bi-x-circle"></i> Hủy
                </a>
            </div>
        }
    </div>
</div>