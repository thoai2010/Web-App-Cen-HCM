@model QLBH.Models.KhuyenMai

@{
    ViewBag.Title = "Sửa khuyến mãi";

    // Lấy vai trò từ Session
    var role = Session["VaiTro"] != null ? Session["VaiTro"].ToString() : "";

    // Nếu là admin thì dùng AdminLayout
    if (role == "Admin" || role == "1")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_NhanVien.cshtml";

    }

    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
    string cenBgLight = "#F5F6F8";
}

<style>
    body { background-color: @cenBgLight; }
    .cen-header { color:@cenGreen; font-weight:700; }
    .card { border:none; border-radius:15px; box-shadow:0 4px 10px rgba(0,0,0,0.1); }
    .btn-cen { background-color:@cenOrange; color:white; border:none; transition:.3s; }
    .btn-cen:hover { background-color:#ff9b2f; }
    .form-label { font-weight:600; color:@cenGreen; }
    .btn-back { color:@cenGreen; font-weight:500; text-decoration:none; }
    .btn-back:hover { color:@cenOrange; text-decoration:underline; }
</style>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="cen-header"><i class="bi bi-pencil-square"></i> Cập nhật khuyến mãi</h2>
        <a href="@Url.Action("Index", "QLKhuyenMai")" class="btn-back">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card p-4">
        @using (Html.BeginForm("Edit", "QLKhuyenMai", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.MaKM)

            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="row g-3">

                <div class="col-md-12">
                    <label class="form-label">Mã khuyến mãi</label>
                    <input type="text" class="form-control" value="@Model.MaKM" readonly />
                </div>

                <div class="col-md-12">
                    <label class="form-label">Tên chương trình</label>
                    @Html.TextBoxFor(m => m.TenCT, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.TenCT, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Ngày bắt đầu</label>
                    @Html.TextBoxFor(m => m.NgayBD, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                    @Html.ValidationMessageFor(m => m.NgayBD, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Ngày kết thúc</label>
                    @Html.TextBoxFor(m => m.NgayKT, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                    @Html.ValidationMessageFor(m => m.NgayKT, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-12">
                    <label class="form-label">Loại khuyến mãi</label>
                    @Html.DropDownListFor(m => m.LoaiKM,
                        new SelectList(new[]
                        {
                            new { Value="TheoDonHang", Text="Theo đơn hàng"},
                            new { Value="TheoSanPham", Text="Theo sản phẩm"},
                            new { Value="Voucher", Text="Voucher"},
                            new { Value="Freeship", Text="Freeship"},
                        }, "Value", "Text", Model.LoaiKM),
                        "Chọn loại khuyến mãi",
                        new { @class = "form-control", required = "required" }
                    )
                    @Html.ValidationMessageFor(m => m.LoaiKM, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-12">
                    <label class="form-label">Mô tả (tuỳ chọn)</label>
                    @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 3 })
                </div>

            </div>

            <div class="mt-4 text-end">
                <button type="submit" class="btn btn-cen px-4">
                    <i class="bi bi-save"></i> Cập nhật
                </button>
                <a href="@Url.Action("Index", "QLKhuyenMai")" class="btn btn-secondary px-4">
                    <i class="bi bi-x-circle"></i> Hủy
                </a>
            </div>
        }
    </div>
</div>
