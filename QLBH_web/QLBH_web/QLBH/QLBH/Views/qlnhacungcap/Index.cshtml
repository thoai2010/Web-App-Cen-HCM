@model IEnumerable<QLBH.Models.NhaCungCap>

@{
    ViewBag.Title = "Quản lý Nhà Cung Cấp";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
    string cenBgLight = "#F5F6F8";
}

<style>
    body { background-color:@cenBgLight; }

    .cen-header { color:@cenGreen; font-weight:700; }
    .cen-table thead { background-color:@cenGreen; color:white; }
    .cen-table tbody tr:hover { background-color:#e9f6f5; transition:.25s; }

    .btn-outline-warning {
        border:2px solid @cenOrange !important; color:@cenOrange !important;
        font-weight:600; border-radius:6px; transition:.3s;
    }
    .btn-outline-warning:hover { background:@cenOrange !important; color:white !important; }

    .btn-add {
        background-color:@cenOrange !important; color:white !important;
        font-weight:600; border-radius:6px; transition:.3s;
    }
    .btn-add:hover { background-color:#ff9b2f !important; }

    .search-box {
        border:2px solid @cenGreen; width:260px;
        padding:6px 12px; border-radius:6px;
    }
    .search-box:focus { border-color:@cenOrange; }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="cen-header"><i class="bi bi-building-fill"></i> Quản lý Nhà cung cấp</h2>

        <div class="d-flex gap-2">
            @using (Html.BeginForm("Index", "QLNhaCungCap", FormMethod.Get))
            {
                <input type="text" name="search" class="form-control search-box"
                       placeholder="🔍 Tìm nhà cung cấp..." value="@Request["search"]" />
            }

            <a href="@Url.Action("Create", "QLNhaCungCap")" class="btn btn-add">
                <i class="bi bi-plus-circle"></i> Thêm nhà cung cấp
            </a>
            <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            @if (TempData["SuccessMessage"] != null)
            {<div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>}

            @if (TempData["ErrorMessage"] != null)
            {<div class="alert alert-danger text-center">@TempData["ErrorMessage"]</div>}

            <table class="table table-hover align-middle mb-0 cen-table text-center">
                <thead>
                    <tr>
                        <th>Mã NCC</th>
                        <th>Tên nhà cung cấp</th>
                        <th>Địa chỉ</th>
                        <th>Số điện thoại</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var ncc in Model)
                        {
                            <tr>
                                <td>@ncc.MaNCC</td>
                                <td>@ncc.TenNCC</td>
                                <td>@ncc.DiaChi</td>
                                <td>@ncc.SDT</td>
                                
                                <td>
                                    <a href="@Url.Action("Edit", "QLNhaCungCap", new { id = ncc.MaNCC.Trim() })"
                                       class="btn btn-outline-warning btn-sm">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-muted py-3">Không có dữ liệu nhà cung cấp.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
