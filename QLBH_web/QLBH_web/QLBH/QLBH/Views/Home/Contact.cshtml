@{
    ViewBag.Title = "Liên hệ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/lienhe.css" rel="stylesheet" />

<section class="contact-page py-5" style="background-color:#0f4b47; color:#fff;">
    <div class="container">
        <div class="row">
            <!-- Cột trái: Thông tin công ty -->
            <div class="col-md-5 mb-4">
                <img src="~/Content/images/logo-cenhcm-white.png" alt="CEN HCM" style="width:200px;" />
                <ul class="list-unstyled mt-3">
                    <li><strong>Hotline:</strong> @ViewBag.Company.Hotline</li>
                    <li><strong>Email:</strong> @ViewBag.Company.Email</li>
                    <li><strong>Địa chỉ:</strong> @ViewBag.Company.DiaChi</li>
                </ul>
            </div>

            <!-- Cột phải: Form liên hệ -->
            <div class="col-md-7">
                <h4 class="text-center">LIÊN HỆ VỚI CHÚNG TÔI</h4>
                <form method="post" action="@Url.Action("GuiLienHe","Home")" class="mt-3">
                    <div class="form-group mb-3">
                        <input class="form-control" name="Ten" placeholder="Tên của bạn" />
                    </div>
                    <div class="form-group mb-3">
                        <input class="form-control" name="Email" placeholder="Email của bạn" />
                    </div>
                    <div class="form-group mb-3">
                        <input class="form-control" name="SDT" placeholder="Số điện thoại" />
                    </div>
                    <div class="form-group">
                        <textarea name="NoiDung" class="form-control" placeholder="Nội dung liên hệ" rows="4"></textarea>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-send">GỬI LIÊN HỆ</button>
                    </div>                
                </form>
            </div>
        </div>

        <!-- Bản đồ -->
        <div class="row mt-5">
            <div class="col-12">
                <iframe src="https://www.google.com/maps?q=57%20Nguy%E1%BB%85n%20C%C6%A1%20Th%E1%BA%A1ch,%20An%20Kh%C3%A1nh,%20TP.%20Th%E1%BB%A7%20%C4%90%E1%BB%A9c,%20TP.HCM&output=embed"
                        width="100%" height="400" style="border:0; border-radius:8px;" allowfullscreen></iframe>
            </div>
        </div>

        <div class="text-center mt-4">
            <small>Copyright 2025 © CEN HCM</small>
        </div>
    </div>
</section>
