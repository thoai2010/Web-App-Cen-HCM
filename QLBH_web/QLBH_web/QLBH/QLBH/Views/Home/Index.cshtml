@{
    ViewBag.Title = "Trang chủ - CEN HCM";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var banners = ViewBag.BannerImages as List<string>;
    var danhMuc = ViewBag.DanhMucLoai as List<dynamic>;
    var sanPhamNoiBat = ViewBag.SanPhamNoiBat as List<dynamic>;
    dynamic company = ViewBag.Company as dynamic;
}



<link href="~/Content/home.css" rel="stylesheet" />

<!-- === 1. Banner 3 hình tự động === -->
<div id="homeCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
    <div class="carousel-inner">
        @for (int i = 0; i < banners.Count; i++)
        {
            var active = i == 0 ? "active" : "";
            <div class="carousel-item @active">
                <img src="@banners[i]" class="d-block w-100" style="height:480px; object-fit:cover;" alt="Banner @(i+1)">
                <div class="carousel-caption d-none d-md-block">
                    <h1 class="display-4 font-weight-bold">CEN HCM</h1>
                    <p>Realizing your dreams</p>
                </div>
            </div>
        }
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
    </button>
</div>


<!-- === 2. Giới thiệu công ty === -->
<section class="about-section py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 text-center">
                <img src="~/Content/images/gioithieu.jpg" class="img-fluid rounded shadow-lg" alt="Giới thiệu CEN HCM" />
            </div>

            <div class="col-md-6 d-flex flex-column justify-content-center align-items-center text-center">
                <div class="about-box">
                    <h2 class="about-title mb-3">VỀ CEN HCM</h2>
                    <p class="about-text mb-4">
                        CEN HCM là đơn vị tiên phong trong lĩnh vực đầu tư và phân phối bất động sản tại khu vực phía Nam.
                        Với đội ngũ chuyên nghiệp và tận tâm, chúng tôi mang đến giải pháp toàn diện cho khách hàng và đối tác.
                    </p>
                    <a href="@Url.Action("About","Home")" class="btn btn-view-more">XEM THÊM</a>
                </div>
            </div>
        </div>
    </div>
</section>



<!-- === 3. Danh mục loại === -->
<section class="container my-5">
    <h3 class="text-center mb-4 text-uppercase">Danh mục loại</h3>
    <div class="row">
        @if (danhMuc != null)
        {
            foreach (dynamic loai in danhMuc)
            {
                <div class="col-6 col-md-3 mb-4">
                    <div class="card category-card border-0 shadow-sm h-100 text-center">
                        <img src="@loai.Hinh" class="card-img-top" alt="@loai.TenLoai" style="height:160px; object-fit:cover;" />
                        <div class="card-body">
                            <h6>@loai.TenLoai</h6>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted">Không có danh mục.</div>
        }
    </div>
</section>

<!-- === 4. Sản phẩm nổi bật === -->
<section class="container my-5">
    <h3 class="text-center mb-4 text-uppercase">Sản phẩm nổi bật</h3>
    <div class="row">
        @if (sanPhamNoiBat != null)
        {
            foreach (dynamic sp in sanPhamNoiBat)
            {
                <div class="col-6 col-md-3 mb-4">
                    <div class="card product-card border-0 shadow-sm h-100">
                        <img src="@sp.Hinh" class="card-img-top" style="height:180px; object-fit:cover;" alt="@sp.TenSP" />
                        <div class="card-body text-center">
                            <h6>@sp.TenSP</h6>
                            <p class="price text-danger font-weight-bold">@String.Format("{0:N0}", sp.GiaBan) ₫</p>
                            <a href="@Url.Action("ChiTiet", "SanPham", new { id = sp.MaSP })" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted">Chưa có sản phẩm nổi bật.</div>
        }
    </div>
</section>

<!-- === 5. Liên hệ / Footer === -->
<section class="contact-section py-5">
    <div class="container">
        <div class="row">
            <!-- Thông tin công ty -->
            <div class="col-md-5 mb-4">
                <img src="~/Content/images/logo-cenhcm-white.png" alt="CEN HCM" class="footer-logo" />
                <p class="mt-3">Hotline: @ViewBag.Company.Hotline</p>
                <p>Email: @ViewBag.Company.Email</p>
                <p>Địa chỉ: @ViewBag.Company.DiaChi</p>
                <ul class="footer-address">
                    <li><strong>Trụ sở chính:</strong> 57 Nguyễn Cơ Thạch, An Khánh, Tp Hồ Chí Minh</li>
                    <li><strong>CN Cần Thơ:</strong> 153Q Trần Hưng Đạo, Ninh Kiều, Cần Thơ</li>
                </ul>
                <div class="social-icons mt-4">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-tiktok"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                </div>
            </div>

            <!-- Form liên hệ -->
            <div class="col-md-7">
                <h4 class="text-center">LIÊN HỆ VỚI CHÚNG TÔI</h4>
                <form method="post" action="@Url.Action("GuiLienHe","Home")" class="mt-3">
                    <div class="form-group mb-3">
                        <input class="form-control" name="Ten" placeholder="Tên của bạn" />
                    </div>
                    <div class="form-group mb-3">
                        <input class="form-control" name="Email" placeholder="Email của bạn" />
                    </div>
                    <div class="form-group mb-3">
                        <input class="form-control" name="SDT" placeholder="Số điện thoại" />
                    </div>
                    <button class="btn btn-outline-light px-4">ĐĂNG KÝ NGAY</button>
                </form>
            </div>
        </div>

        <!-- Copyright -->
        <div class="text-center mt-4 pt-3 border-top border-light">
            <small>Copyright 2025 © <strong>CEN HCM</strong></small>
        </div>
    </div>
</section>


@section scripts {
    <script>
        $('#homeCarousel').carousel({ interval: 5000 });
    </script>
}
