@model QLBH.Models.NhanVien

@{
    ViewBag.Title = "Chỉnh sửa Nhân viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
    string cenBgLight = "#F5F6F8";
}

<style>
    body { background-color: @cenBgLight; }
    .cen-header { color: @cenGreen; font-weight: 700; }
    .card { border: none; border-radius: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
    .btn-cen { background-color: @cenOrange; color: white; border: none; transition: .3s; }
    .btn-cen:hover { background-color: #ff9b2f; }
    .form-label { font-weight: 600; color: @cenGreen; }
    .preview-img { width: 120px; height: 120px; border: 2px solid @cenGreen; object-fit: cover; }
    .btn-back { color: @cenGreen; font-weight: 500; text-decoration: none; }
    .btn-back:hover { color: @cenOrange; text-decoration: underline; }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="cen-header">
            <i class="bi bi-pencil-square"></i> Sửa thông tin nhân viên
        </h2>
        <a href="@Url.Action("Index", "NhanVien")" class="btn-back">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card p-4">
        @using (Html.BeginForm("Edit", "NhanVien", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.HiddenFor(m => m.MaNV)

            <div class="row g-4">
                <div class="col-md-4 text-center">
                    <img id="previewImg"
                         src="@Url.Content("~/Images/NhanVien/" + (Model.AnhDaiDien ?? "noavatar.png"))"
                         class="preview-img mb-3" alt="Ảnh nhân viên" />
                    <input type="file" name="AnhDaiDienFile" id="AnhDaiDienFile"
                           class="form-control" accept="image/*"
                           onchange="previewImage(event)" />
                </div>

                <div class="col-md-8">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Tên Nhân viên</label>
                            @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", required = "required" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Chức vụ</label>
                            @Html.TextBoxFor(m => m.ChucVu, new { @class = "form-control" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Số điện thoại</label>
                            @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tài khoản đăng nhập</label>
                            @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>

                    <div class="mt-4 text-end">
                        <button type="submit" class="btn btn-cen px-4">
                            <i class="bi bi-save"></i> Lưu thay đổi
                        </button>
                        <a href="@Url.Action("Index", "NhanVien")" class="btn btn-secondary px-4">
                            <i class="bi bi-x-circle"></i> Hủy
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(event) {
            const reader = new FileReader();
            reader.onload = function () {
                document.getElementById('previewImg').src = reader.result;
            }
            reader.readAsDataURL(event.target.files[0]);
        }
    </script>
}
