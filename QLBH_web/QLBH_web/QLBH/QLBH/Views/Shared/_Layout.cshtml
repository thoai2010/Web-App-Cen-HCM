<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - CEN HCM</title>
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/home.css" />
    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>

</head>
<body>
    <!-- ====== NAVBAR ====== -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color:#0f4b47;">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")">
                <img src="~/Content/images/logo-cenhcm-white.png" alt="CEN HCM" height="40" class="mr-2" />
            </a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#cenNav" aria-controls="cenNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="cenNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link text-white font-weight-bold" href="@Url.Action("Index","Home")">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white font-weight-bold" href="@Url.Action("DanhMuc","SanPham")">Sản phẩm</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white font-weight-bold" href="@Url.Action("ThanhToan","GioHang")">Thanh toán</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white font-weight-bold" href="@Url.Action("Contact","Home")">Liên hệ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="@Url.Action("Index","GioHang")">
                            <img src="~/Content/images/cart-white.png" alt="Giỏ hàng" height="22" />
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- ====== MAIN CONTENT ====== -->
    <div class="container-fluid p-0">
        @RenderBody()
    </div>

    @RenderSection("scripts", required: false)
</body>
</html>
