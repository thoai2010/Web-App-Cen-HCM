@model QLBH.Models.SanPham

@{
    ViewBag.Title = "Thêm sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
    string cenBgLight = "#F5F6F8";
}

<style>
    body { background-color:@cenBgLight; }
    .cen-header { color:@cenGreen; font-weight:700; }
    .card { border:none; border-radius:15px; box-shadow:0 4px 10px rgba(0,0,0,0.1); }
    .btn-cen { background-color:@cenOrange; color:white; border:none; transition:.3s; }
    .btn-cen:hover { background-color:#ff9b2f; }
    .form-label { font-weight:600; color:@cenGreen; }
    #previewImg { width:150px; height:150px; object-fit:cover; border:1px solid #ccc; }
</style>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="cen-header"><i class="bi bi-box-seam"></i> Thêm sản phẩm</h2>
        <a href="@Url.Action("Index","QLSanPham")" class="text-decoration-none text-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    @if (TempData["Success"] != null)
    {<div class="alert alert-success">@TempData["Success"]</div>}

    @if (TempData["Error"] != null)
    {<div class="alert alert-danger">@TempData["Error"]</div>}

    <div class="card p-4">
        @using (Html.BeginForm("Create", "QLSanPham", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="row g-4">

                <!-- ✅ Hình -->
                <div class="col-md-4 text-center">
                    <img id="previewImg" src="https://via.placeholder.com/150" class="mb-3" />
                    <input type="file" name="HinhAnh" class="form-control" accept="image/*"
                           onchange="previewImage(event)" />
                </div>

                <!-- ✅ Form -->
                <div class="col-md-8">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">Tên sản phẩm</label>
                            @Html.TextBoxFor(m => m.TenSP, new { @class = "form-control", required = "required", placeholder = "Nhập tên sản phẩm" })
                            @Html.ValidationMessageFor(m => m.TenSP, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Giá bán</label>
                            @Html.TextBoxFor(m => m.GiaBan, new { @class = "form-control", type = "number", step = "0.01", required = "required", placeholder = "Giá bán" })
                            @Html.ValidationMessageFor(m => m.GiaBan, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Số lượng tồn</label>
                            @Html.TextBoxFor(m => m.SLTon, new { @class = "form-control", type = "number", required = "required", placeholder = "Số lượng tồn" })
                            @Html.ValidationMessageFor(m => m.SLTon, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Loại sản phẩm</label>
                            @Html.DropDownListFor(m => m.MaLoai, (IEnumerable<SelectListItem>)ViewBag.LoaiList, "-- Chọn loại --", new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.MaLoai, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Nhà cung cấp</label>
                            @Html.DropDownListFor(m => m.MaNCC, (IEnumerable<SelectListItem>)ViewBag.NCCList, "-- Chọn nhà cung cấp --", new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.MaNCC, "", new { @class = "text-danger" })
                        </div>

                    </div>

                    <div class="mt-4 text-end">
                        <button type="submit" class="btn btn-cen px-4">
                            <i class="bi bi-save"></i> Lưu
                        </button>
                        <a href="@Url.Action("Index","QLSanPham")" class="btn btn-secondary px-4">
                            <i class="bi bi-x-circle"></i> Hủy
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(event) {
            const reader = new FileReader();
            reader.onload = e => document.getElementById('previewImg').src = e.target.result;
            reader.readAsDataURL(event.target.files[0]);
        }
    </script>
}
