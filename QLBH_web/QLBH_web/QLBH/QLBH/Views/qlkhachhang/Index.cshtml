@model IEnumerable<QLBH.Models.KhachHangViewModel>

@{
    ViewBag.Title = "Quản lý khách hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
    string cenBgLight = "#F5F6F8";
}

<style>
    body { background-color:@cenBgLight; }
    .cen-header { color:@cenGreen; font-weight:700; }

    .cen-table thead { background-color:@cenGreen; color:white; }
    .cen-table tbody tr:hover { background-color:#e9f6f5; transition:.25s; }

    .btn-outline-warning {
        border: 2px solid @cenOrange !important; color:@cenOrange !important;
        font-weight:600; border-radius:6px; transition:.3s;
    }
    .btn-outline-warning:hover {
        background:@cenOrange !important; color:white !important;
    }

    .search-box {
        border:2px solid @cenGreen; width:260px;
        padding:6px 12px; border-radius:6px;
    }
    .search-box:focus { border-color:@cenOrange; }

    .img-kh {
        width:55px; height:55px; object-fit:cover;
        border:1px solid #ccc; border-radius:0;
    }
</style>


<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="cen-header"><i class="bi bi-people"></i> Quản lý khách hàng</h2>

        <div class="d-flex gap-2">
            @using (Html.BeginForm("Index", "QLKhachHang", FormMethod.Get))
            {
                <input type="text" name="search" value="@Request["search"]"
                       class="form-control search-box"
                       placeholder="🔍 Tìm khách hàng..." />
            }

            <a href="@Url.Action("Index","Admin")" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0 cen-table text-center">
                <thead>
                    <tr>
                        <th>Ảnh</th>
                        <th>Mã KH</th>
                        <th>Tên KH</th>
                        <th>Địa chỉ</th>
                        <th>Email</th>
                        <th>SĐT</th>
                        <th>Tài khoản</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var kh in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(kh.AnhDaiDien))
                                {
                                    <img src="@Url.Content(kh.AnhDaiDien)" class="img-kh" />
                                }
                                else
                                {
                                    <img src="~/Images/NhanVien/noavatar.png" class="img-kh" />
                                }
                            </td>
                            <td>@kh.MaKH</td>
                            <td>@kh.TenKH</td>
                            <td>@kh.DiaChi</td>
                            <td>@kh.Email</td>
                            <td>@kh.SDT</td>
                            <td>@kh.TenDangNhap</td>
                            <td>
                                @if (kh.TrangThai == "Hoạt động")
                                {<span class="badge bg-success">Hoạt động</span> }
                                else
                                { <span class="badge bg-secondary">Khóa</span>}
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
