@model IEnumerable<QLBH.Models.KhuyenMai>

@{
    ViewBag.Title = "Quản lý khuyến mãi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
    string cenBgLight = "#F5F6F8";
}

<style>
    body { background-color:@cenBgLight; }

    .cen-header { color:@cenGreen; font-weight:700; }
    .cen-table thead { background-color:@cenGreen; color:white; }
    .cen-table tbody tr:hover { background-color:#e9f6f5; transition:.25s; }

    .btn-outline-warning {
        border:2px solid @cenOrange !important; color:@cenOrange !important;
        font-weight:600; border-radius:6px; transition:.3s;
    }
    .btn-outline-warning:hover { background:@cenOrange !important; color:white !important; }

    .btn-add {
        background-color:@cenOrange !important; color:white !important;
        font-weight:600; border-radius:6px; transition:.3s;
    }
    .btn-add:hover { background-color:#ff9b2f !important; }

    .search-box {
        border:2px solid @cenGreen; width:260px;
        padding:6px 12px; border-radius:6px;
    }
    .search-box:focus { border-color:@cenOrange; }
</style>


<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="cen-header"><i class="bi bi-gift-fill"></i> Quản lý khuyến mãi</h2>

        <div class="d-flex gap-2">
            @using (Html.BeginForm("Index", "QLKhuyenMai", FormMethod.Get))
            {
                <input type="text" name="search" value="@Request["search"]"
                       class="form-control search-box"
                       placeholder="🔍 Tìm chương trình..." />
            }

            <a href="@Url.Action("Create", "QLKhuyenMai")" class="btn btn-add">
                <i class="bi bi-plus-circle"></i> Thêm khuyến mãi
            </a>
            <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (TempData["SuccessMessage"] != null)
            {<div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>}

            @if (TempData["ErrorMessage"] != null)
            {<div class="alert alert-danger text-center">@TempData["ErrorMessage"]</div>}

            <table class="table table-hover align-middle mb-0 cen-table text-center">
                <thead>
                    <tr>
                        <th>Mã KM</th>
                        <th>Tên chương trình</th>
                        <th>Ngày bắt đầu</th>
                        <th>Ngày kết thúc</th>
                        <th>Điều kiện</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var km in Model)
                    {
                        <tr>
                            <td>@km.MaKM</td>
                            <td>@km.TenCT</td>
                            <td>@km.NgayBD.ToString("dd/MM/yyyy")</td>
                            <td>@km.NgayKT.ToString("dd/MM/yyyy")</td>
                            <td>@km.DieuKien</td>
                            
                            <td>
                                <a href="@Url.Action("Edit", "QLKhuyenMai", new { id = km.MaKM.Trim() })"
                                   class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
