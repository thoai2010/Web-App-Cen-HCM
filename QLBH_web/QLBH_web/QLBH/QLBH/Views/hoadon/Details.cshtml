@model QLBH.Models.HoaDon

@{
    ViewBag.Title = "Chi tiết hóa đơn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 p-4 bg-white rounded shadow-sm">
    <h2 class="text-center text-primary mb-4">Chi tiết hóa đơn</h2>

    <table class="table table-bordered">
        <tr><th>Mã hóa đơn</th><td>@Model.MaHD</td></tr>
        <tr><th>Khách hàng</th><td>@Model.TenKH</td></tr>
        <tr><th>Nhân viên</th><td>@Model.TenNV</td></tr>
        <tr><th>Ngày lập</th><td>@(Model.NgayLap?.ToString("dd/MM/yyyy"))</td></tr>
        <tr><th>Phương thức thanh toán</th><td>@Model.PhuongThucThanhToan</td></tr>
        <tr><th>Tổng tiền</th><td>@Model.SoTien.ToString("N0") ₫</td></tr>
    </table>

    <h4 class="mt-4 text-secondary">Sản phẩm trong hóa đơn</h4>
    <table class="table table-striped">
        <thead class="table-primary">
            <tr>
                <th>Tên sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ChiTietSP)
            {
                <tr>
                    <td>@item.TenSP</td>
                    <td>@item.SoLuong</td>
                    <td>@item.DonGia.ToString("N0") ₫</td>
                    <td>@((item.SoLuong * item.DonGia).ToString("N0")) ₫</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-center mt-3">
        <a href="@Url.Action("Index", "HoaDon")" class="btn btn-secondary">⬅ Quay lại</a>
    </div>
</div>
