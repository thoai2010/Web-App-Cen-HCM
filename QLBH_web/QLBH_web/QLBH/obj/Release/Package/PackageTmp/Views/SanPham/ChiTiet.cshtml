@model QLBH.Models.SanPham
@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
    var danhGiaList = ViewBag.DanhGia as List<QLBH.Models.DanhGia> ?? new List<QLBH.Models.DanhGia>();
    bool choPhep = ViewBag.ChoPhepDanhGia == true;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .product-box{
        background:white;
        padding:25px;
        border-radius:12px;
        box-shadow:0 2px 10px rgba(0,0,0,.08);
    }
    .product-img-box {
        width: 100%;
        height: 380px;
        display:flex;
        justify-content:center;
        align-items:center;
        background:#fff;
        border:1px solid #eee;
        border-radius:10px;
        padding:10px;
    }
    .product-img-box img{ max-width:100%; max-height:100%; object-fit:contain; }
    .price{ color:@cenOrange; font-weight:700; font-size:24px; margin-top:10px; }
    .btn-orange{ background:@cenOrange; color:white; }
    .btn-orange:hover{ background:#db7f18; color:white; }
    .info-label { font-weight:600; color:#444; }

    /* Rating stars in modal */
    .star-input { cursor: pointer; font-size: 22px; color: #dcdcdc; }
    .star-input.checked { color: #f5c518; }
</style>

<div class="container mt-4 mb-4">
    <div class="product-box">
        <div class="row g-4">
            <div class="col-md-5">
                <div class="product-img-box">
                    @{
                        string hinh = Model.Hinh ?? "";
                        string corrected = hinh.StartsWith("/Content")
                            ? hinh.Replace("/Content", "")
                            : hinh;
                    }

                    <img src="/Content/@corrected"
                         onerror="this.src='@Url.Content("~/Content/images/no-image.png")'" />
                </div>
            </div>

            <div class="col-md-7">
                <h3 class="fw-bold" style="color:@cenGreen;">@Model.TenSP</h3>

                <p><span class="info-label">Số lượng tồn:</span> @Model.SLTon</p>
                <p><span class="info-label">Đơn vị tính:</span> @Model.DonViTinh</p>
                <p><span class="info-label">Loại sản phẩm:</span> @Model.TenLoai</p>

                <div class="price">@String.Format("{0:N0} ₫", Model.GiaBan)</div>

                <div class="mt-4 d-flex gap-3">
                    <a href="@Url.Action("ThemYeuThich","YeuThich", new { id = Model.MaSP })"
                       class="btn btn-outline-danger px-4">
                        <i class="fa fa-heart"></i> Yêu thích
                    </a>

                    <form method="post" action="@Url.Action("ThemVaoGio", "GioHang", new { id = Model.MaSP })" class="flex-fill">
                        <button class="btn btn-orange w-100 py-2">
                            <i class="fa fa-cart-plus"></i> Thêm vào giỏ hàng
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <hr class="mt-4">

        <hr class="mt-4">

        <h5 class="fw-bold"><i class="fa fa-info-circle text-warning"></i> Mô tả sản phẩm</h5>
        <p>@Html.Raw(Model.MoTa)</p>

        <!-- ==== ĐÁNH GIÁ ==== -->
        <hr class="mt-4">
        <h5 class="fw-bold"><i class="fa fa-star text-warning"></i> Đánh giá sản phẩm</h5>

        <!-- Hiện thông báo từ TempData -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        else if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <div id="review-section"></div>

        @if (Session["KhachHang"] == null)
        {
            <p class="text-muted">Vui lòng đăng nhập để đánh giá sản phẩm.</p>
        }
        else if (ViewBag.DaDanhGia == true)
        {
            <div class="alert alert-warning">
                Bạn đã đánh giá sản phẩm này trong đơn hàng <b>@ViewBag.MaDH_DaDanhGia</b>.
                Vui lòng đặt đơn mới để tiếp tục đánh giá.
            </div>
        }
        else if (ViewBag.ChoPhepDanhGia != true)
        {
            <p class="text-muted">Bạn chỉ có thể đánh giá khi đơn hàng chứa sản phẩm này đã hoàn thành.</p>
        }
        else
        {
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalDanhGia">
                <i class="fa fa-pen"></i> Viết đánh giá
            </button>
        }


        @if (ViewBag.DanhGia == null || ((List<QLBH.Models.DanhGia>)ViewBag.DanhGia).Count == 0)
        {
            <p class="text-muted">Chưa có đánh giá nào cho sản phẩm này.</p>
        }
        else
        {
            <div class="mt-3">
                @foreach (var dg in ViewBag.DanhGia)
                {
                    <div class="p-3 mb-3" style="border:1px solid #eee; border-radius:10px;">
                        <div class="d-flex align-items-center mb-2">
                            @{
                                var avatar = !string.IsNullOrEmpty(dg.KhachHang?.AnhDaiDien) ? Url.Content("~/Content/images/khachhang/" + dg.KhachHang.AnhDaiDien) : Url.Content("~/Content/images/no-image.png");
                            }
                            <img src="@avatar"
                                 style="width:45px;height:45px;border-radius:50%;object-fit:cover;margin-right:10px;" />

                            <b>@(dg.KhachHang?.TenKH ?? "Khách hàng")</b>
                        </div>

                        <div class="text-warning mb-2">
                            @for (int i = 1; i <= dg.SoSao; i++)
                            {
                                <i class="fa fa-star"></i>
                            }
                        </div>

                        <div>@dg.NoiDung</div>
                        <small class="text-muted">@dg.NgayDG.ToString("dd/MM/yyyy")</small>
                    </div>
                }
            </div>
        }

    </div>
</div>

<!-- Modal đánh giá -->
<div class="modal fade" id="modalDanhGia" tabindex="-1" aria-labelledby="modalDanhGiaLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("DanhGiaSP", "SanPham")">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="modalDanhGiaLabel">Viết đánh giá</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="MaSP" value="@Model.MaSP" />
                    <input type="hidden" name="MaDH" value="@ViewBag.MaDHForReview" id="inputMaDHForReview" />
                    <div class="mb-3">
                        <label class="form-label">Đánh giá (1-5 sao)</label>
                        <select class="form-select" name="SoSao" required>
                            <option value="">-- Chọn --</option>
                            <option value="5">5 - Xuất sắc</option>
                            <option value="4">4 - Tốt</option>
                            <option value="3">3 - Trung bình</option>
                            <option value="2">2 - Kém</option>
                            <option value="1">1 - Rất kém</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nội dung</label>
                        <textarea name="NoiDung" class="form-control" rows="4" maxlength="500" placeholder="Viết cảm nhận của bạn..."></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Gửi đánh giá</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // Star rating interaction
            const stars = document.querySelectorAll('#star-input .star');
            const soSaoInput = document.getElementById('SoSao');

            function setStars(count) {
                stars.forEach(s => {
                    const v = parseInt(s.getAttribute('data-value'));
                    if (v <= count) {
                        s.classList.remove('fa-regular');
                        s.classList.add('fa-solid');
                    } else {
                        s.classList.remove('fa-solid');
                        s.classList.add('fa-regular');
                    }
                });
                soSaoInput.value = count;
            }

            stars.forEach(s => {
                s.addEventListener('mouseenter', function () {
                    const v = parseInt(this.getAttribute('data-value'));
                    setStars(v);
                });
                s.addEventListener('click', function () {
                    const v = parseInt(this.getAttribute('data-value'));
                    setStars(v);
                });
            });

            // reset stars when modal opened (if you want default 5)
            var modal = document.getElementById('modalDanhGia');
            modal?.addEventListener('shown.bs.modal', function () {
                setStars(parseInt(soSaoInput.value || '5'));
            });
        })();
    </script>
}