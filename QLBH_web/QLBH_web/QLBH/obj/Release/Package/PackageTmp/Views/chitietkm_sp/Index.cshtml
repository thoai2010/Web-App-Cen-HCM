@model IEnumerable<QLBH.Models.ChiTietKM_SP>

@{
    ViewBag.Title = "Quản lý sản phẩm khuyến mãi";
    var role = Session["VaiTro"] != null ? Session["VaiTro"].ToString() : "";

    // Nếu là admin thì dùng AdminLayout
    if (role == "Admin" || role == "1")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_NhanVien.cshtml";

    }

    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
    string cenBgLight = "#F5F6F8";
}

<style>
    body { background-color:@cenBgLight; }

    .cen-header { color:@cenGreen; font-weight:700; }

    .cen-table thead { background-color:@cenGreen; color:white; }
    .cen-table tbody tr:hover { background-color:#e9f6f5; transition:.25s; }

    .btn-add {
        background-color:@cenOrange; color:white;
        font-weight:600; padding:6px 12px; border-radius:6px;
    }
    .btn-add:hover { background-color:#ff9b2f; }

    .btn-outline-danger {
        border:2px solid #d9534f !important; color:#d9534f !important;
        font-weight:600; border-radius:6px; padding:5px 12px; transition:.3s;
    }
    .btn-outline-danger:hover {
        background:#d9534f !important; color:white !important;
    }

    .search-box {
        border:2px solid @cenGreen; width:260px;
        padding:6px 12px; border-radius:6px;
    }
    .search-box:focus { border-color:@cenOrange; }
</style>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="cen-header">
            <i class="bi bi-gift-fill"></i> Quản lý sản phẩm khuyến mãi
        </h2>

        <div class="d-flex gap-2">
            @using (Html.BeginForm("Index", "ChiTietKM_SP", FormMethod.Get))
            {
                <input type="text" name="search" value="@Request["search"]"
                       class="form-control search-box"
                       placeholder="🔍 Tìm kiếm chương trình..." />
            }

            <a href="@Url.Action("Create", "ChiTietKM_SP")" class="btn-add">
                <i class="bi bi-plus-circle"></i> Thêm mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0 cen-table text-center">
                <thead>
                    <tr>
                        <th>Mã KM</th>
                        <th>Tên chương trình</th>
                        <th>Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th>Trị giá</th>
                        <th>SL tối thiểu</th>
                        <th>Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MaKM</td>
                                <td>@item.TenCT</td>
                                <td>@item.MaSP</td>
                                <td>@item.TenSP</td>
                                <td>@item.TriGia.ToString("N0")</td>
                                <td>@item.SoLuongToiThieu</td>

                                <td>
                                    <form action="@Url.Action("Delete","ChiTietKM_SP")"
                                          method="post"
                                          onsubmit="return confirm('Xóa liên kết khuyến mãi này?');"
                                          style="display:inline-block;">

                                        <input type="hidden" name="maKM" value="@item.MaKM" />
                                        <input type="hidden" name="maSP" value="@item.MaSP" />

                                        <button type="submit" class="btn-outline-danger btn-sm">
                                            <i class="bi bi-trash3-fill"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-muted">Không có dữ liệu.</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

</div>
