@model List<QLBH.Models.CartItem>
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string cenGreen = "#005F59";
    string cenOrange = "#F9C341";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
body { background-color:#F5F6F8; }
.cart-container { background:#fff; border-radius:10px; padding:22px; box-shadow:0 2px 8px rgba(0,0,0,.06);}
th { background:@cenGreen; color:#fff; font-weight:700; text-align:center;}
td { vertical-align:middle; text-align:center;}
.img-thumb { width:80px; height:80px; object-fit:cover; border-radius:6px;}
.btn-orange { background:@cenOrange; color:#fff; border:none;}
.btn-orange:hover { background:#e5b400; color:#fff;}
.btn-green { background:@cenGreen; color:#fff; border:none;}
.btn-green:hover { background:#004f4a; color:#fff;}
.empty-cart { text-align:center; padding:40px 20px;}
</style>

<div class="container mt-5 mb-5">
    <h2 class="text-center mb-4" style="color:@cenOrange;">
        <i class="fa-solid fa-cart-shopping"></i> Giỏ hàng của bạn
    </h2>

    @if (TempData["Success"] != null)
    {<div class="alert alert-success">@TempData["Success"]</div>}
    @if (TempData["Error"] != null)
    {<div class="alert alert-danger">@TempData["Error"]</div>}

    @if (!Model.Any())
    {
        <div class="empty-cart card shadow-sm">
            <div class="card-body">
                <i class="fa-solid fa-cart-arrow-down fa-3x text-warning"></i>
                <p class="mt-3 fw-bold">Giỏ hàng trống.</p>
                <a href="@Url.Action("DanhMuc","SanPham")" class="btn btn-warning">Tiếp tục mua sắm</a>
            </div>
        </div>
    }
    else
    {
        <div class="cart-container">
            @using (Html.BeginForm("CapNhatSoLuong", "GioHang", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <table class="table table-bordered align-middle mb-0">
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="checkAll" /></th>
                            <th>Hình</th>
                            <th>Tên sản phẩm</th>
                            <th>Đơn vị</th>
                            <th>Giá</th>
                            <th>Khuyến mãi</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var it = Model[i];
                            <tr>
                                <td>
                                    <input type="checkbox" name="items[@i].IsSelected" class="chonSP" value="true" @(it.IsSelected ? "checked" : "") />
                                    @Html.Hidden("items[" + i + "].MaSP", it.MaSP)
                                </td>
                                <td>
                                    <img src="@Url.Content(it.HinhAnh ?? "~/Content/images/no-image.png")" class="img-thumb" />
                                </td>
                                <td>@it.TenSP</td>
                                <td>@it.DonViTinh</td>
                                <td>@String.Format("{0:N0} ₫", it.GiaBan)</td>
                                <td>
                                    @if (it.KhuyenMai > 0)
                                    {
                                        <span class="text-success fw-bold">-@String.Format("{0:N0} ₫", it.KhuyenMai)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0 ₫</span>
                                    }
                                </td>
                                <td>
                                    <input type="number" name="items[@i].SoLuong"
                                           min="1" max="@it.SLTon"
                                           value="@it.SoLuong" class="form-control text-center" />
                                </td>
                                <td data-thanhtien="@it.ThanhTienSauKM">@String.Format("{0:N0} ₫", it.ThanhTienSauKM)</td>
                                <td>
                                    <a href="@Url.Action("Xoa","GioHang", new { id=it.MaSP })"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="fa fa-trash"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap">
                    <div class="mb-2">
                        <a href="@Url.Action("XoaTatCa","GioHang")" class="btn btn-outline-danger">
                            <i class="fa fa-trash-can"></i> Xóa tất cả
                        </a>
                    </div>

                    <div class="text-end mb-2">
                        <div class="mb-2">
                            Tổng tiền (các sản phẩm đã chọn):
                            <span class="fw-bold" id="tongTien" style="color:@cenOrange;">0 ₫</span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-orange">
                                <i class="fa fa-rotate"></i> Cập nhật giỏ hàng
                            </button>

                            <button type="button" class="btn btn-green" id="btnThanhToan">
                                <i class="fa-solid fa-credit-card"></i> Thanh toán
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
document.getElementById("checkAll")?.addEventListener("change", function () {
    document.querySelectorAll(".chonSP").forEach(cb => cb.checked = this.checked);
    tinhTong();
});

document.querySelectorAll(".chonSP").forEach(cb => cb.addEventListener("change", tinhTong));
document.querySelectorAll("input[type=number]").forEach(inp => inp.addEventListener("change", tinhTong));

function tinhTong() {
    let tong = 0;
    document.querySelectorAll("tbody tr").forEach(row => {
        let checkbox = row.querySelector(".chonSP");
        if (checkbox && checkbox.checked) {
            let cell = row.querySelector("td[data-thanhtien]");
            if (cell) {
                let gia = cell.getAttribute("data-thanhtien");
                tong += parseFloat(gia) || 0;
            }
        }
    });
    document.getElementById("tongTien").textContent = tong.toLocaleString() + " ₫";
}

tinhTong();

document.getElementById("btnThanhToan")?.addEventListener("click", function () {
    let selected = Array.from(document.querySelectorAll(".chonSP:checked"))
                        .map(cb => cb.closest("tr").querySelector("input[type=hidden]").value);
    if (selected.length === 0) {
        alert("Vui lòng chọn ít nhất 1 sản phẩm để thanh toán!");
        return;
    }
    let url = '@Url.Action("Index", "Checkout")' + '?ids=' + selected.join(',');
    window.location.href = url;
});
</script>
