@model QLBH.Models.NhanVien
@{
    ViewBag.Title = "Sửa Nhân viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string cenGreen = "#005F59";
    string cenOrange = "#F7941D";
    string cenBgLight = "#F5F6F8";
}

<style>
    body { background-color: @cenBgLight; }
    .cen-header { color: @cenGreen; font-weight: 700; }
    .card { border: none; border-radius: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
    .btn-cen { background-color: @cenOrange; color: white; border: none; transition: .3s; }
    .btn-cen:hover { background-color: #ff9b2f; }
    .form-label { font-weight: 600; color: @cenGreen; }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="cen-header">
            <i class="bi bi-pencil-square"></i> Sửa Nhân viên
        </h2>
        <a href="@Url.Action("Index", "QLNhanVien")" class="text-decoration-none text-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    @* ✅ Hiển thị lỗi SQL *@
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @* ✅ Validation summary *@
    @Html.ValidationSummary(false, "", new { @class = "alert alert-warning" })

    <div class="card p-4">
        @using (Html.BeginForm("Edit", "QLNhanVien", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <div class="row g-4">

                <!-- Ảnh đại diện -->
                <div class="col-md-4 text-center">
                    <img id="previewImg"
                         src="@(Model?.AnhDaiDien != null ? Url.Content("~/Content/images/nhanvien/" + Model.AnhDaiDien) : "https://cdn-icons-png.flaticon.com/512/149/149071.png")"
                         width="120" height="120" class="border mb-3" />

                    <input type="file" name="AnhDaiDien" class="form-control"
                           accept="image/*" onchange="previewImage(event)" />
                </div>

                <div class="col-md-8">
                    <div class="row g-3">

                        <!-- Mã nhân viên (readonly) -->
                        <div class="col-md-6">
                            <label class="form-label">Mã Nhân viên</label>
                            <input type="text" class="form-control"
                                   value="@Model.MaNV" readonly style="background:#e9ecef;" />
                            <input type="hidden" name="MaNV" value="@Model.MaNV" />
                        </div>

                        <!-- Họ tên -->
                        <div class="col-md-6">
                            <label class="form-label">Tên Nhân viên</label>
                            @Html.TextBoxFor(m => m.HoTen,
                                new { @class = "form-control", placeholder = "Nhập họ tên" })
                            @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger" })
                        </div>

                        <!-- Chức vụ -->
                        <div class="col-md-6">
                            <label class="form-label">Chức vụ</label>
                            @Html.TextBoxFor(m => m.ChucVu,
                                new { @class = "form-control", placeholder = "VD: Kinh doanh" })
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            @Html.TextBoxFor(m => m.Email,
                                new { @class = "form-control", type = "email" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>

                        <!-- Số điện thoại -->
                        <div class="col-md-6">
                            <label class="form-label">Số điện thoại</label>
                            @Html.TextBoxFor(m => m.SoDienThoai,
                                new { @class = "form-control", placeholder = "VD: 0912345678" })
                        </div>

                        <!-- Tài khoản đăng nhập -->
                        <div class="col-md-6">
                            <label class="form-label">Tài khoản đăng nhập</label>
                            <input type="text" class="form-control" value="@Model.TenDangNhap" readonly style="background:#e9ecef;" />
                            <input type="hidden" name="TenDangNhap" value="@Model.TenDangNhap" />
                        </div>
                    </div>

                    <!-- Nút Lưu / Hủy -->
                    <div class="mt-4 text-end">
                        <button type="submit" class="btn btn-cen px-4">
                            <i class="bi bi-save"></i> Lưu
                        </button>
                        <a href="@Url.Action("Index", "QLNhanVien")" class="btn btn-secondary px-4">
                            <i class="bi bi-x-circle"></i> Hủy
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        function previewImage(event) {
            const reader = new FileReader();
            reader.onload = function () {
                document.getElementById('previewImg').src = reader.result;
            };
            reader.readAsDataURL(event.target.files[0]);
        }
    </script>
}
